    uart_checker_uart_checker -> uart_checker_clock [color="#1565c0", penwidth=1.0, edgetooltip="clock_cfg → clock_in"];

    subgraph cluster_legend {
        label="Legend";
        style="filled,rounded"; fillcolor="#f5f5f5"; color="#cccccc";
        fontsize=10;
        node [shape=plaintext, fillcolor="#f5f5f5"];

        legend [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4">
            <TR><TD><FONT COLOR="#e65100">━━━</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DMA</FONT></TD></TR>
            <TR><TD><FONT COLOR="#7b1fa2">━━━</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">Local memory</FONT></TD></TR>
            <TR><TD><FONT COLOR="#1565c0">━━━</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">Data</FONT></TD></TR>
            <TR><TD><FONT COLOR="#0288d1">╌╌╌</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">Instruction fetch</FONT></TD></TR>
            <TR><TD><FONT COLOR="#43a047">╌╌╌</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">Control / IRQ</FONT></TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">Arrow = master → slave</FONT></TD></TR>
            </TABLE>
        >];
    }
}