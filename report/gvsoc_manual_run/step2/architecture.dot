digraph "pulp-open" {
    rankdir=TB;
    newrank=true;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=9, shape=record, style="filled,rounded"];
    edge [fontname="Helvetica", fontsize=7];
    compound=true;
    splines=ortho;
    nodesep=0.5;
    ranksep=0.7;

    label="pulp-open — Architecture Diagram\n(auto-generated from GVSoC Python generators)";
    labelloc=t;
    fontsize=13;

    subgraph cluster_chip {
        label="chip";
        style="filled,rounded"; fillcolor="#e3f2fd"; color="#1565c0";
        fontsize=10;

        chip_padframe [label="padframe\n(Padframe)", fillcolor="#a5d6a7"];
        chip_soc_clock_domain [label="soc_clock_domain\n(Clock_domain)", fillcolor="#a5d6a7"];
        chip_cluster_clock [label="cluster_clock\n(Clock_domain)", fillcolor="#a5d6a7"];
        subgraph cluster_chip_cluster {
            label="cluster";
            style="filled,rounded"; fillcolor="#c8e6c9"; color="#43a047";
            fontsize=10;

            subgraph cluster_chip_cluster_l1 {
                label="l1";
                style="filled,rounded"; fillcolor="#fff3e0"; color="#e65100";
                fontsize=10;

                chip_cluster_l1_bank_group [label="bank x16\n(Memory)\n4 KB each, 64 KB total", fillcolor="#f8bbd0", shape=box3d];
                chip_cluster_l1_pe_ico_group [label="pe_ico x9\n(Router)\nBW=0B", fillcolor="#f8bbd0", shape=box3d];
                chip_cluster_l1_interleaver [label="interleaver\n(L1_interleaver)", fillcolor="#f8bbd0"];
                chip_cluster_l1_ext2loc [label="ext2loc\n(Converter)", fillcolor="#f8bbd0"];
                chip_cluster_l1_ext2loc_ts [label="ext2loc_ts\n(Converter)", fillcolor="#f8bbd0"];
            }

            chip_cluster_pe_group [label="pe x9\n(ClusterCore)", fillcolor="#ffcc80", shape=box3d];
            subgraph cluster_chip_cluster_icache {
                label="icache";
                style="filled,rounded"; fillcolor="#fff3e0"; color="#e65100";
                fontsize=10;

                chip_cluster_icache_l_bank_group [label="l_bank x11\n(Cache)", fillcolor="#f8bbd0", shape=box3d];
                chip_cluster_icache_interleaver [label="interleaver\n(Interleaver)", fillcolor="#f8bbd0"];
            }

            chip_cluster_event_unit [label="event_unit\n(Event_unit)", fillcolor="#ffcc80"];
            chip_cluster_cluster_ico [label="cluster_ico\n(Router)\nBW=0B", fillcolor="#ffcc80"];
            chip_cluster_periph_ico [label="periph_ico\n(Router)\nBW=0B", fillcolor="#ffcc80"];
            chip_cluster_demux_periph_ico [label="demux_periph_ico\n(Router)\nBW=0B", fillcolor="#ffcc80"];
            chip_cluster_dma [label="dma\n(Mchan)", fillcolor="#ffcc80"];
            chip_cluster_timer [label="timer\n(Timer)", fillcolor="#ffcc80"];
            chip_cluster_cluster_ctrl [label="cluster_ctrl\n(Cluster_control)", fillcolor="#ffcc80"];
            chip_cluster_icache_ctrl [label="icache_ctrl\n(Icache_ctrl)", fillcolor="#ffcc80"];
        }

        subgraph cluster_chip_soc {
            label="soc";
            style="filled,rounded"; fillcolor="#c8e6c9"; color="#43a047";
            fontsize=10;

            chip_soc_loader [label="loader\n(ElfLoader)", fillcolor="#ffcc80"];
            chip_soc_debug_rom [label="debug_rom\n(Memory)", fillcolor="#ffcc80"];
            chip_soc_fll_soc [label="fll_soc\n(Fll)", fillcolor="#ffcc80"];
            chip_soc_fll_periph [label="fll_periph\n(Fll)", fillcolor="#ffcc80"];
            chip_soc_fll_cluster [label="fll_cluster\n(Fll)", fillcolor="#ffcc80"];
            chip_soc_fc [label="fc\n(FcCore)", fillcolor="#ffcc80"];
            chip_soc_fc_itc [label="fc_itc\n(Itc_v1)", fillcolor="#ffcc80"];
            chip_soc_fc_icache [label="fc_icache\n(Cache)", fillcolor="#ffcc80"];
            chip_soc_fc_icache_ctrl [label="fc_icache_ctrl\n(Icache_ctrl)", fillcolor="#ffcc80"];
            chip_soc_apb_soc_ctrl [label="apb_soc_ctrl\n(Apb_soc_ctrl)", fillcolor="#ffcc80"];
            chip_soc_apb_ico [label="apb_ico\n(Router)\nBW=0B", fillcolor="#ffcc80"];
            subgraph cluster_chip_soc_soc_ico {
                label="soc_ico";
                style="filled,rounded"; fillcolor="#fff3e0"; color="#e65100";
                fontsize=10;

                chip_soc_soc_ico_ll_ico [label="ll_ico\n(Router)\nBW=0B", fillcolor="#f8bbd0"];
                chip_soc_soc_ico_hb_ico [label="hb_ico\n(Router)\nBW=0B", fillcolor="#f8bbd0"];
                chip_soc_soc_ico_fc_fetch_ico [label="fc_fetch_ico\n(Router)\nBW=0B", fillcolor="#f8bbd0"];
                chip_soc_soc_ico_fc_data_ico [label="fc_data_ico\n(Router)\nBW=0B", fillcolor="#f8bbd0"];
                chip_soc_soc_ico_udma_rx_ico [label="udma_rx_ico\n(Router)\nBW=0B", fillcolor="#f8bbd0"];
                chip_soc_soc_ico_udma_tx_ico [label="udma_tx_ico\n(Router)\nBW=0B", fillcolor="#f8bbd0"];
            }

            chip_soc_axi_ico [label="axi_ico\n(Router)\nBW=0B", fillcolor="#ffcc80"];
            chip_soc_gpio [label="gpio\n(Gpio)", fillcolor="#ffcc80"];
            chip_soc_udma [label="udma\n(Udma)", fillcolor="#ffcc80"];
            subgraph cluster_chip_soc_l2 {
                label="l2";
                style="filled,rounded"; fillcolor="#fff3e0"; color="#e65100";
                fontsize=10;

                chip_soc_l2_priv0 [label="priv0\n(Memory)\n32 KB", fillcolor="#f8bbd0"];
                chip_soc_l2_priv1 [label="priv1\n(Memory)\n32 KB", fillcolor="#f8bbd0"];
                chip_soc_l2_l_shared_group [label="l_shared x12\n(Interleaver)", fillcolor="#f8bbd0", shape=box3d];
                chip_soc_l2_shared_cut_group [label="shared_cut x48\n(Memory)\n32 KB each, 2 MB total", fillcolor="#f8bbd0", shape=box3d];
            }

            chip_soc_soc_eu [label="soc_eu\n(Soc_eu)", fillcolor="#ffcc80"];
            chip_soc_timer [label="timer\n(Timer)", fillcolor="#ffcc80"];
            chip_soc_timer_1 [label="timer_1\n(Timer)", fillcolor="#ffcc80"];
            chip_soc_stdout [label="stdout\n(Stdout)", fillcolor="#ffcc80"];
            chip_soc_pulp_tag [label="pulp_tag\n(Pulp_tap)", fillcolor="#ffcc80"];
            chip_soc_riscv_tap [label="riscv_tap\n(Riscv_tap)", fillcolor="#ffcc80"];
            chip_soc_gdbserver [label="gdbserver\n(Gdbserver)", fillcolor="#ffcc80"];
            chip_soc_periph_clock [label="periph_clock\n(Clock_domain)", fillcolor="#ffcc80"];
        }

        chip_fast_clock [label="fast_clock\n(Clock_domain)", fillcolor="#a5d6a7"];
        chip_fast_clock_generator [label="fast_clock_generator\n(Clock_generator)", fillcolor="#a5d6a7"];
        chip_ref_clock [label="ref_clock\n(Clock_domain)", fillcolor="#a5d6a7"];
        chip_ref_clock_generator [label="ref_clock_generator\n(Clock_generator)", fillcolor="#a5d6a7"];
        chip_axi_proxy [label="axi_proxy\n(Router_proxy)", fillcolor="#a5d6a7"];
    }

    hyperflash [label="hyperflash\n(Hyperflash)\n64 MB", fillcolor="#90caf9"];
    ram [label="ram\n(Hyperram)\n8 MB", fillcolor="#90caf9"];
    subgraph cluster_uart_checker {
        label="uart_checker";
        style="filled,rounded"; fillcolor="#e3f2fd"; color="#1565c0";
        fontsize=10;

        uart_checker_uart_checker [label="uart_checker\n(Uart_checker_implem)", fillcolor="#a5d6a7"];
        uart_checker_clock [label="clock\n(Clock_domain)", fillcolor="#a5d6a7"];
    }


    // ===================== CONNECTIONS =====================
    chip_padframe -> hyperflash [color="#1565c0", penwidth=1.0, edgetooltip="hyper0_cs1_data_pad → input"];
    chip_padframe -> ram [color="#1565c0", penwidth=1.0, edgetooltip="hyper0_cs0_data_pad → input"];
