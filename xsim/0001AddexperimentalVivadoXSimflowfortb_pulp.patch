+// Stub DPI cho lan bring-up dau tien tren XSim.
+// SimJTAG.sv luon duoc instantiate trong tb_pulp, nen xelab can symbol
+// jtag_tick. Khi ENABLE_OPENOCD = 0 thi SimJTAG bi disable (enable = 0)
+// va ham nay khong bao gio duoc goi -> stub la du.
+// Muon dung OpenOCD that thi thay bang rtl/tb/remote_bitbang/*.c
+#include "svdpi.h"
+
+int jtag_tick(unsigned char *jtag_TCK, unsigned char *jtag_TMS,
+              unsigned char *jtag_TDI, unsigned char *jtag_TRSTn,
+              unsigned char jtag_TDO)
+{
+    (void)jtag_TDO;
+    *jtag_TCK   = 0;
+    *jtag_TMS   = 0;
+    *jtag_TDI   = 0;
+    *jtag_TRSTn = 1;
+    return 0;
+}
diff --git a/xsim/fix_bender_typos.sh b/xsim/fix_bender_typos.sh
new file mode 100755
index 0000000..ad540a5
--- /dev/null
+++ b/xsim/fix_bender_typos.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# Va lai 2 typo upstream trong manifest cua IP (bender >= 0.29 bao [E31]).
+# Chay tu thu muc goc repo pulp, sau khi './bender checkout' da xong.
+set -euo pipefail
+cd "$(dirname "${BASH_SOURCE[0]}")"
+
+fix() {  # $1 = duong dan sai, $2 = ten file that
+  local bad="$1" good="$2"
+  [ -e "$bad" ] && { echo "  da co: $bad"; return; }
+  [ -f "$(dirname "$bad")/$good" ] || { echo "  bo qua (khong thay $good): $bad"; return; }
+  ln -sf "$good" "$bad"
+  echo "  fix: $bad -> $good"
+}
+
+echo "common_cells (typo: clk_div.s)"
+for d in .bender/git/checkouts/common_cells-*/src/deprecated; do
+  [ -d "$d" ] && fix "$d/clk_div.s" clk_div.sv
+done
+
+echo "adv_dbg_if (typo: adbg_axi_biu.sv,)"
+for d in .bender/git/checkouts/adv_dbg_if-*/rtl; do
+  [ -d "$d" ] && fix "$d/adbg_axi_biu.sv," adbg_axi_biu.sv
+done
+
+echo "Xong. Chay lai: ./bender script flist -t rtl -t test >/dev/null && echo OK"
diff --git a/xsim/gen_filelists.sh b/xsim/gen_filelists.sh
new file mode 100755
index 0000000..6ff4283
--- /dev/null
+++ b/xsim/gen_filelists.sh
@@ -0,0 +1,96 @@
+#!/usr/bin/env bash
+# Sinh file list cho Vivado XSim tu Bender.
+# Chay tu thu muc goc cua repo pulp:   ./xsim/gen_filelists.sh
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+OUT="$ROOT/xsim"
+BENDER="$ROOT/bender"
+
+[ -x "$BENDER" ] || { echo "Khong tim thay ./bender - chay 'make checkout' truoc"; exit 1; }
+echo "bender: $("$BENDER" --version)"
+
+# ---------------------------------------------------------------------------
+# Pre-flight: bender >= 0.29 kiem tra su ton tai cua moi file trong manifest
+# va bao [E31]. common_cells v1.24.0 co typo upstream:
+#   src/deprecated/clk_div.s   (file that la clk_div.sv)
+# Vong lap duoi day tu tao symlink cho moi file thieu ma tim duoc ban .sv/.v.
+# ---------------------------------------------------------------------------
+# Doan duong dan that tu duong dan sai trong manifest.
+# In ra duong dan dung, hoac chuoi rong neu khong doan duoc.
+resolve_typo() {
+  local p="$1" c
+  [ -f "$p" ] && { printf '%s' "$p"; return; }
+  for c in "${p}v" "${p%,}" "${p%.*}.sv" "${p%.*}.v" "${p%.*}.vhd" "${p%.*}.svh"; do
+    [ -f "$c" ] && { printf '%s' "$c"; return; }
+  done
+  printf ''
+}
+
+heal_missing_files() {
+  local tries=0 err missing cand
+  while [ $tries -lt 20 ]; do
+    if err=$("$BENDER" script flist -t rtl -t test 2>&1 >/dev/null); then
+      return 0
+    fi
+    missing=$(printf '%s' "$err" | sed 's/\x1b\[[0-9;]*m//g' \
+              | sed -n 's/.*\[E31\] File \(.*\) doesn.t exist.*/\1/p' | head -1)
+    if [ -z "$missing" ]; then
+      echo "bender loi (khong phai E31):" >&2; echo "$err" >&2; return 1
+    fi
+    cand="$(resolve_typo "$missing")"
+    if [ -z "$cand" ]; then
+      echo "Khong tim duoc file thay the cho: $missing" >&2; return 1
+    fi
+    echo "  [fix] $(basename "$missing") -> $(basename "$cand")"
+    ln -sf "$(basename "$cand")" "$missing"
+    tries=$((tries+1))
+  done
+  echo "Qua nhieu file thieu, dung lai." >&2; return 1
+}
+
+echo "=== kiem tra manifest ==="
+heal_missing_files
+
+# ---------------------------------------------------------------------------
+# Targets: rtl + test  (khong bat vip/dpi de don gian hoa lan build dau)
+# ---------------------------------------------------------------------------
+RAW="$OUT/all.flist"
+"$BENDER" script flist -t rtl -t test > "$RAW"
+
+grep '^+incdir+' "$RAW" | sed 's/^+incdir+//' > "$OUT/incdirs.txt"
+
+SRC="$(grep -v '^+' "$RAW" | grep -v '^[[:space:]]*$')"
+
+# Cac file DPI-only: bo ra khoi lan build dau (khong duoc instantiate khi
+# ENABLE_DPI / ENABLE_EXTERNAL_DRIVER / TARGET_RT_DPI = 0)
+EXCLUDE_RE='dpi_models/dpi_models\.sv|tb_driver/tb_driver\.sv|rtl/tb/SimDTM\.sv'
+
+: > "$OUT/vhdl.f"
+: > "$OUT/sv.f"
+
+{
+  echo "-d TARGET_RTL"
+  echo "-d TARGET_TEST"
+  echo "-d TARGET_SIMULATION"
+  while read -r d; do echo "-i $d"; done < "$OUT/incdirs.txt"
+} >> "$OUT/sv.f"
+
+while IFS= read -r f; do
+  [ -z "$f" ] && continue
+  echo "$f" | grep -Eq "$EXCLUDE_RE" && continue
+  # bender tra ve duong dan sai (typo upstream); doi sang file that
+  if [ ! -f "$f" ]; then
+    r="$(resolve_typo "$f")"
+    [ -n "$r" ] || { echo "BO QUA (khong tim thay): $f" >&2; continue; }
+    f="$r"
+  fi
+  case "$f" in
+    *.vhd|*.vhdl) echo "$f" >> "$OUT/vhdl.f" ;;
+    *)            echo "$f" >> "$OUT/sv.f"   ;;
+  esac
+done <<< "$SRC"
+
+echo "sv.f   : $(grep -c '^/' "$OUT/sv.f") file"
+echo "vhdl.f : $(wc -l < "$OUT/vhdl.f") file"
+echo "incdir : $(wc -l < "$OUT/incdirs.txt")"
diff --git a/xsim/run.sh b/xsim/run.sh
new file mode 100755
index 0000000..0ff8a46
--- /dev/null
+++ b/xsim/run.sh
@@ -0,0 +1,63 @@
+#!/usr/bin/env bash
+# Compile + elaborate + run tb_pulp bang Vivado XSim.
+# Dung tu thu muc goc repo:   ./xsim/run.sh [compile|elab|sim|all] [gui]
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+WORKDIR="$ROOT/xsim/work"        # noi chua xsim.dir
+STIM="${STIM:-$ROOT/xsim/vectors/stim.txt}"
+SNAP=tb_pulp_snap
+STEP="${1:-all}"
+GUI="${2:-}"
+
+command -v xvlog >/dev/null || { echo "Chua source settings64.sh cua Vivado"; exit 1; }
+
+mkdir -p "$WORKDIR"
+cd "$WORKDIR"
+
+compile() {
+  echo "=== xvhdl (16 file FLL) ==="
+  xvhdl --work work --relax -f "$ROOT/xsim/vhdl.f" 2>&1 | tee xvhdl.log
+
+  echo "=== xvlog (SystemVerilog) ==="
+  # --relax noi long mot so kiem tra LRM ma XSim von rat kho tinh
+  xvlog --sv --work work --relax -f "$ROOT/xsim/sv.f" 2>&1 | tee xvlog.log
+
+  echo "=== xsc (DPI stub) ==="
+  xsc "$ROOT/xsim/dpi_stub.c" -o dpi_stub.so 2>&1 | tee xsc.log
+}
+
+elab() {
+  echo "=== xelab ==="
+  xelab work.tb_pulp \
+    -s $SNAP \
+    --relax --debug typical --mt 8 \
+    --timescale 1ps/1ps \
+    -sv_lib dpi_stub -sv_root "$WORKDIR/xsim.dir/work/xsc" \
+    -generic_top "BAUDRATE=115200" \
+    -generic_top "USE_SDVT_SPI=0" \
+    -generic_top "USE_SDVT_CPI=0" \
+    -generic_top "ENABLE_DEV_DPI=0" \
+    -generic_top "USE_SDVT_I2S=0" \
+    -L work \
+    2>&1 | tee xelab.log
+}
+
+sim() {
+  echo "=== xsim ==="
+  mkdir -p vectors
+  [ -f "$STIM" ] && cp -f "$STIM" vectors/stim.txt
+  if [ "$GUI" = "gui" ]; then
+    xsim $SNAP -gui -testplusarg "stimuli=./vectors/stim.txt"
+  else
+    xsim $SNAP -testplusarg "stimuli=./vectors/stim.txt" -R -log xsim.log
+  fi
+}
+
+case "$STEP" in
+  compile) compile ;;
+  elab)    elab ;;
+  sim)     sim ;;
+  all)     compile; elab; sim ;;
+  *) echo "usage: $0 [compile|elab|sim|all] [gui]"; exit 1 ;;
+esac
